# ============================================================
# NarrativeOS — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
# ============================================================

# ---- Gemini API (required for extraction + verification) ----
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Extractor switch (gemini | adapted) ----
# Set to "adapted" only after the fine-tuned model endpoint is ready
EXTRACTOR=gemini

# ---- Adaption fine-tuned model (Member 3 fills after fine-tune) ----
# ADAPTED_MODEL_ENDPOINT=https://your-adaption-inference-endpoint/extract
# ADAPTED_API_KEY=your_adaption_or_together_ai_key_here
