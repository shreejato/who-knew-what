{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://narrativeos-api.onrender.com/$1" }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://narrativeos-api.onrender.com"
  }
}
